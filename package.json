{
  "name": "twist-turbo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node tools/dev.mjs cluster",
    "dev:price": "node tools/dev.mjs price",
    "storybook": "turbo run storybook --filter=cluster",
    "storybook:price": "turbo run storybook --filter=price",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "mock-rgs": "node tools/mock-rgs/server.mjs",
    "publish-packages": "turbo run build lint test && changeset version && changeset publish"
  },
  "dependencies": {
    "eslint": "9.21.0",
    "eslint-config-custom": "workspace:*",
    "prettier": "3.5.2",
    "prettier-plugin-svelte": "3.3.3",
    "turbo": "2.4.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.5.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}